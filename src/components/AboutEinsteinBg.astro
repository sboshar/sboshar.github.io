---
/**
 * Full-viewport background: wireframe H7/H8 hat continuum (Tile(a,b) morph).
 * Glow on the wire under the pointer; touching a hat wire spawns pulses along that tile’s perimeter.
 */
---

<div class="einstein-hat-bg-root">
  <canvas
    id="einstein-hat-canvas"
    width="300"
    height="150"
    aria-hidden="true"
    tabindex="-1"
  ></canvas>
</div>
<canvas
  id="einstein-hat-canvas-panels"
  class="einstein-panel-canvas"
  width="300"
  height="150"
  aria-hidden="true"
  tabindex="-1"
></canvas>

<script>
  import { initEinsteinHatBg } from '../scripts/einstein-hat-bg.ts';

  initEinsteinHatBg('einstein-hat-canvas');
</script>

<style>
  .einstein-hat-bg-root {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    /* Own compositing layer: less repaint coupling while main content scrolls on mobile. */
    isolation: isolate;
  }

  .einstein-hat-bg-root canvas {
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    opacity: 0.16;
    /* Crisp hexagon-tiling look — no blur. */
    filter: none;
    transform: translateZ(0);
    transition: filter 0.4s ease;
    animation: tiles-settle 2.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .einstein-panel-canvas {
    position: fixed;
    inset: 0;
    z-index: 9;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
    filter: drop-shadow(6px 7px 0 color-mix(in srgb, var(--color-accent-soft) 72%, transparent));
  }

  :global(.dark) .einstein-hat-bg-root canvas {
    opacity: 0.16;
    filter: none;
  }

  @keyframes tiles-settle {
    0%, 42% { opacity: 0.42; }
    100% { opacity: 0.16; }
  }

  @media (prefers-reduced-motion: reduce) {
    .einstein-hat-bg-root canvas,
    :global(.dark) .einstein-hat-bg-root canvas,
    .einstein-panel-canvas {
      filter: none;
      transition: none;
      animation: none;
    }
  }
</style>
