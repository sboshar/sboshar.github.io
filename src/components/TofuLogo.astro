---
import { siteHref } from '../lib/site-url';
import tofuInline from '../assets/tofu-inline.svg?raw';
---

<a
  href={siteHref()}
  class="tofu-logo-link fixed top-5 left-5 z-50 block h-20 w-20 transition-opacity hover:opacity-70"
  aria-label="Home"
  set:html={tofuInline}
/>

<style>
  .tofu-logo-link {
    transition: opacity 160ms ease;
  }

  .tofu-logo-link:hover {
    opacity: 0.65;
  }

  .tofu-logo-link :global(svg) {
    display: block;
    height: 100%;
    width: 100%;
    object-fit: contain;
    object-position: top;
    filter: drop-shadow(3px 4px 0 color-mix(in srgb, var(--color-accent) 42%, transparent));
  }

  @media (max-width: 720px) {
    .tofu-logo-link {
      top: 0.85rem;
      left: 0.75rem;
      width: 4rem;
      height: 4rem;
    }
  }
</style>
